<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Install: see docs/xo/pilot-checklist.md. Replace __REPO__ and __NODE_BIN__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ateamgpt.xo.health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/xo-ops/healthcheck.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>XO_HOME</key>
    <string>/Users/Shared/xo</string>
    <key>XO_INSTANCE_ID</key>
    <string>xo-pilot</string>
    <key>XO_REPO</key>
    <string>__REPO__</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/Shared/xo/logs/health.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/xo/logs/health.log</string>
</dict>
</plist>
